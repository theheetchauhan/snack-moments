# --- Database ---------------------------------------------------------------
# Leave empty to use the embedded PGlite database in ./.data (zero setup, local only).
# For deployment, use a Postgres URL, e.g. Supabase (Settings → Database → connection string, "Transaction" pooler).
DATABASE_URL=

# --- AI (optional) ------------------------------------------------------------
# Without a key every AI feature falls back to transparent rule-based logic.
OPENROUTER_API_KEY=
# Model ids on OpenRouter (any provider). The critic should be a DIFFERENT model family from the writer.
AI_MODEL_WRITER=anthropic/claude-sonnet-5.5
AI_MODEL_CRITIC=google/gemini-3.8-flash
AI_MODEL_FAST=openai/gpt-5.4-mini

# Salt for hashing IP addresses (never stored raw)
IP_SALT=change-me

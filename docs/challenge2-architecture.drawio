<mxfile host="app.diagrams.net"><diagram id="d" name="Technical architecture: verification and onboarding"><mxGraphModel dx="1660" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="&lt;b&gt;Player web app (Next.js)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Works in Chrome, Safari and on desktop&lt;br&gt;Records steps in PostHog · invisible bot check&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="400" height="82" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;“Ask for help” screen (our team)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Team sees help requests and flagged accounts&lt;br&gt;Replies in 2 working days · only allowed staff&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="400" height="82" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Secure connection · blocks attacks and bots · limits too many requests&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c4523e;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="820" height="60" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;AWS Mumbai: all personal data stays in India&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#7fa6c9;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1140" height="690" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;API gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Checks who is signed in on every request · stops the same answer being saved twice · limits requests per player and device&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="1100" height="62" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Sign-in service&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Google / Apple sign-in&lt;br&gt;Creates the account&lt;br&gt;Moves guest points in&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="200" height="120" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Game and study service&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Games and answers&lt;br&gt;Answers on hold until verified&lt;br&gt;Answer quality (Part B)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="258" y="410" width="200" height="120" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Risk and trust service&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Device, network and speed checks&lt;br&gt;Finds look-alike accounts&lt;br&gt;Trust score (Part 4)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="476" y="410" width="200" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Rewards service&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Pays only verified players&lt;br&gt;One reward per person&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="694" y="410" width="200" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Verification service&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Keeps each player&amp;#x27;s status&lt;br&gt;Talks to the provider&lt;br&gt;Works out age (Indian time)&lt;br&gt;Turns IDs into hashes&lt;br&gt;Switches to backup if needed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="912" y="410" width="228" height="140" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;App database (Postgres)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Players · answers (on hold or not)&lt;br&gt;Devices · help requests&lt;br&gt;Email and phone encrypted&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#e8f6ef;strokeColor=#3a9472;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="330" height="110" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;PostHog&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;On our own server&lt;br&gt;Funnels, A/B tests&lt;br&gt;No personal data&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#e8f6ef;strokeColor=#3a9472;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="160" height="110" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Key store (AWS KMS)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Keys for hashing&lt;br&gt;and encryption&lt;br&gt;Changed regularly&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c4523e;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="170" height="110" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Identity vault (separate Postgres)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;One row per DigiLocker (hashed)&lt;br&gt;Birth year, how and when verified&lt;br&gt;Every verification attempt + log&lt;br&gt;Deleted accounts (kept 12 months)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#fdecea;strokeColor=#c4523e;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="890" y="610" width="250" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Background tasks (outbox + queue + workers)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Releases held answers when a player is verified (saved together with the status) · reminders on day 1 and day 3, stopped once verified&lt;br&gt;Marks unfinished checks as expired after 30 minutes · daily numbers (cost, duplicates, answers still on hold)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="860" height="82" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Notification service&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Checks the player agreed&lt;br&gt;Email · WhatsApp · browser alerts&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="920" y="770" width="220" height="82" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Logs never include name, birth date or email · alerts on Slack when checks start failing or the provider has errors&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="1100" height="60" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Outside services&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcfaff;strokeColor=#b8afe0;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="1270" y="60" width="370" height="910" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Google / Apple sign-in&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Confirms who signed in&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="95" width="330" height="56" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Provider A&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;main · ₹2.49 per check&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="200" width="160" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Provider B&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;backup&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1460" y="200" width="160" height="70" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;DigiLocker (government)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Secure login (OAuth)&lt;br&gt;Shares the player&amp;#x27;s details and documents&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="330" width="330" height="84" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Document issuers&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Aadhaar (UIDAI), Transport, Income Tax&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="465" width="330" height="60" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Email (Amazon SES)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="700" width="330" height="46" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;WhatsApp (Gupshup)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="760" width="330" height="46" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Browser alerts (Firebase)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="820" width="330" height="46" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Slack alerts&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1290" y="892" width="330" height="46" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Screen&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="155" height="26" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Security / sensitive&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c4523e;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="210" y="990" width="155" height="26" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Service&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="380" y="990" width="155" height="26" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Verification&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="550" y="990" width="155" height="26" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Database&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6ef;strokeColor=#3a9472;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="720" y="990" width="155" height="26" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Background&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="890" y="990" width="155" height="26" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Outside service&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1060" y="990" width="155" height="26" as="geometry"/></mxCell><mxCell id="e0" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="162" as="sourcePoint"/><mxPoint x="240" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="162" as="sourcePoint"/><mxPoint x="660" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="250" as="sourcePoint"/><mxPoint x="450" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;
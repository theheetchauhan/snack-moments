<mxfile host="app.diagrams.net"><diagram id="d" name="Onboarding and verification flow"><mxGraphModel dx="1250" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="&lt;b&gt;Player (Chrome, Safari or desktop browser)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8f8fc;strokeColor=#c9c4da;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="370" height="1340" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Hot Takes servers (AWS Mumbai)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8f8fc;strokeColor=#c9c4da;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="430" y="52" width="410" height="1340" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Outside services&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8f8fc;strokeColor=#c9c4da;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="860" y="52" width="360" height="1340" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Opens a Hot Takes link&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;No app to install, no form to fill&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="95" width="320" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;POST /sessions&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Checks it&amp;#x27;s a real person, not a bot&lt;br&gt;Gives this browser a guest ID&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="455" y="95" width="360" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Cloudflare Turnstile&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Bot check the player doesn&amp;#x27;t see&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="880" y="95" width="320" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Plays the sample game&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;About 2 minutes of snack cards&lt;br&gt;Points shown, not saved yet&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="200" width="320" height="74" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Step tracking&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Each step is recorded in PostHog&lt;br&gt;so we can see where people leave&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="455" y="200" width="360" height="74" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;“Save your points?”&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Sign in with Google in one tap&lt;br&gt;(Apple on iPhone). No password&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="310" width="320" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;POST /auth/google&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Checks the Google sign-in is genuine&lt;br&gt;Creates the account&lt;br&gt;Moves the guest points into it&lt;br&gt;Keeps the player signed in&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="455" y="304" width="360" height="96" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Google sign-in&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Confirms who signed in&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="880" y="318" width="320" height="66" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Age and city&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Player types their age (we check it later)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="425" width="320" height="64" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;PATCH /me/profile&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Saves age and city&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="455" y="425" width="360" height="64" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Plays first real study&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Can keep playing more studies&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="525" width="320" height="74" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;POST /studies/:id/responses&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Saves answers “on hold”&lt;br&gt;They don&amp;#x27;t count until the player verifies&lt;br&gt;Also scores answer quality (Part B)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="455" y="520" width="360" height="84" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Claims first reward&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;This is when we ask them to verify.&lt;br&gt;Before this they just play,&lt;br&gt;and their answers stay on hold.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="640" width="320" height="100" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;“What we see” screen&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;We see: name, age, DigiLocker ID&lt;br&gt;We never see: Aadhaar number,&lt;br&gt;address or documents&lt;br&gt;We keep: verified + birth year&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="790" width="320" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;POST /verification/start&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Max 5 tries a day&lt;br&gt;Gives them 30 minutes to finish&lt;br&gt;Creates a one-time secret code&lt;br&gt;so nobody can fake the reply&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="455" y="790" width="360" height="100" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Verification provider&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Connects us to DigiLocker&lt;br&gt;₹2.49 per successful check&lt;br&gt;Backup provider if this one is down&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="880" y="790" width="320" height="100" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Goes to DigiLocker&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Player sees the real government page&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="65" y="945" width="320" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;DigiLocker&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Player logs in with DigiLocker&amp;#x27;s own OTP&lt;br&gt;and agrees to share their details&lt;br&gt;No Aadhaar linked? They can share&lt;br&gt;PAN or driving licence instead&lt;br&gt;Uploaded photos are never accepted&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;strokeColor=#8a5cc2;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="880" y="925" width="320" height="130" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;DigiLocker sends the result back&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Check it&amp;#x27;s the same player who started&lt;br&gt;Read name, date of birth, DigiLocker ID&lt;br&gt;PAN or licence: check the government signed it&lt;br&gt;If the result comes twice, use it once&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="455" y="1090" width="360" height="120" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Check the result&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Are they 18 or older?&lt;br&gt;Is this DigiLocker already&lt;br&gt;used by another account?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;strokeWidth=1.5;fontSize=12;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="465" y="1245" width="340" height="130" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Said no / no DigiLocker&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Tapped Deny, or has&lt;br&gt;no DigiLocker account&lt;br&gt;Show what we see again&lt;br&gt;and how to create one&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#c45c50;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="182" height="150" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Left halfway&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Didn&amp;#x27;t come back&lt;br&gt;in 30 minutes&lt;br&gt;Banner in the app, email&lt;br&gt;+ WhatsApp (if agreed)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1e0;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="237" y="1460" width="182" height="150" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;DigiLocker down&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Try the backup provider&lt;br&gt;If both are down: “busy,&lt;br&gt;try later” + a reminder&lt;br&gt;Not counted as a try&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1e0;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="434" y="1460" width="182" height="150" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Verified&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Held answers now count&lt;br&gt;Reward unlocked&lt;br&gt;We keep only: verified&lt;br&gt;and birth year&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f4df;strokeColor=#4c9a44;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="631" y="1460" width="182" height="150" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Already used&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Linked to another account&lt;br&gt;Show its email (h***@gmail.com)&lt;br&gt;“Ask for help”: the team&lt;br&gt;replies in 2 working days&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#c45c50;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="828" y="1460" width="182" height="150" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Under 18&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Held answers deleted&lt;br&gt;Can&amp;#x27;t try again&lt;br&gt;(so they can&amp;#x27;t use a&lt;br&gt;parent&amp;#x27;s DigiLocker)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#c45c50;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="1025" y="1460" width="182" height="150" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Reward paid&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;Their answers now count in the study&lt;br&gt;Trust level grows over time (Part 4)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f4df;strokeColor=#4c9a44;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="591" y="1660" width="262" height="74" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;What the player sees&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="135" height="26" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Our server&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="187" y="1760" width="135" height="26" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Verification step&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="334" y="1760" width="135" height="26" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Outside service&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f4ecfd;
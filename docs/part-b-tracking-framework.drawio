<mxfile host="app.diagrams.net"><diagram id="d" name="Part B tracking framework: Capture → Compute → Act → Learn"><mxGraphModel dx="1240" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n0" value="&lt;b&gt;1. Capture (player&amp;#x27;s browser)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8f8fc;strokeColor=#c9c4da;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="290" height="720" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;2. Compute (server)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8f8fc;strokeColor=#c9c4da;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="335" y="52" width="290" height="720" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;3. Act&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8f8fc;strokeColor=#c9c4da;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="640" y="52" width="290" height="720" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;4. Learn&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8f8fc;strokeColor=#c9c4da;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#3b3560;" vertex="1" parent="1"><mxGeometry x="945" y="52" width="290" height="720" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Tracker&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;One event stream for every game&lt;br&gt;Sent in batches every 2 seconds&lt;br&gt;Sent right away if the player leaves&lt;br&gt;No scoring in the browser&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="260" height="120" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;What it records&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;question shown (+ expected time)&lt;br&gt;first touch · options looked at&lt;br&gt;change of mind · cancelled tap · confirm&lt;br&gt;swipes · peeks · shelf and budget cuts&lt;br&gt;crowd guess · typed or pasted text&lt;br&gt;leaving the app · idle · drop-off&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="45" y="255" width="260" height="150" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;POST /api/events&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;checked with Zod, then saved&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="45" y="440" width="260" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;event_log&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;raw events, never edited&lt;br&gt;hashed device and IP&lt;br&gt;no personal details&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#e8f6ef;strokeColor=#3a9472;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="45" y="545" width="260" height="90" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Expected-time model&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;reading + options + how close the choice is&lt;br&gt;residual = log(actual ÷ expected)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="260" height="82" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Noise signals (11)&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;rushing · same spot · repeat flip&lt;br&gt;overpriced twin · random fit …&lt;br&gt;→ quality score 0–100&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="350" y="210" width="260" height="92" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Divergence signals&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;say vs do · self vs crowd&lt;br&gt;choice vs shelf · bid vs model&lt;br&gt;→ findings, never a penalty&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="260" height="82" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Engagement score 0–100&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;finish · healthy time · depth&lt;br&gt;focus · tiredness&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="350" y="440" width="260" height="70" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Cross-session checks&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;shared device · same answer pattern&lt;br&gt;look-alike groups · sudden bursts&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="350" y="538" width="260" height="82" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;session_scores&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;scores + reasons per session&lt;br&gt;formula version (quality-v1.3)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=9;fillColor=#e8f6ef;strokeColor=#3a9472;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="350" y="648" width="260" height="78" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Live checks during the game&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;running warning total (CUSUM)&lt;br&gt;above 1.6 → add a repeat question&lt;br&gt;or an overpriced twin&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="655" y="100" width="260" height="100" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Follow-up question&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;asks about the biggest contradiction&lt;br&gt;the answer is saved as a finding&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f4df;strokeColor=#4c9a44;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="655" y="230" width="260" height="90" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Weight in brand results&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;green (70+) counts fully&lt;br&gt;amber (40–69) counts 0.3–0.9&lt;br&gt;red (2+ strong signs) left out&lt;br&gt;nobody is blocked automatically&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f4df;strokeColor=#4c9a44;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="655" y="350" width="260" height="110" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Admin dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;funnel · timing · games · rewards&lt;br&gt;flagged sessions with reasons&lt;br&gt;AI explains each one in plain words&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a4760;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="655" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Team review&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;flagged sessions checked by hand&lt;br&gt;approve · count less · exclude&lt;br&gt;saved in review_labels&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="260" height="100" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Tune and rescore&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;compare team decisions with scores&lt;br&gt;adjust weights → new formula version&lt;br&gt;rescore old sessions from raw events&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="960" y="230" width="260" height="100" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Random tests&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;framing (protein or taste first)&lt;br&gt;price anchor · reward size&lt;br&gt;→ difference with a confidence range&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="960" y="360" width="260" height="100" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Question health&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot; color=&amp;quot;#5d5a6e&amp;quot;&gt;where people quit or rush&lt;br&gt;which questions tell us most&lt;br&gt;→ rewrite weak ones in the Studio&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="260" height="100" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Browser&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#4f74d0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="30" y="822" width="148" height="26" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Scoring&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff3e2;strokeColor=#d08a30;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="190" y="822" width="148" height="26" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Database&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6ef;strokeColor=#3a9472;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="350" y="822" width="148" height="26" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Used in results&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f4df;strokeColor=#4c9a44;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="510" y="822" width="148" height="26" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Live check&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="670" y="822" width="148" height="26" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Learning loop&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef6fb;strokeColor=#3f88b0;strokeWidth=1.5;fontSize=13;fontColor=#1f1d2b;" vertex="1" parent="1"><mxGeometry x="830" y="822" width="148" height="26" as="geometry"/></mxCell><mxCell id="e0" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="220" as="sourcePoint"/><mxPoint x="175.0" y="255" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="405" as="sourcePoint"/><mxPoint x="175.0" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="510" as="sourcePoint"/><mxPoint x="175.0" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="182" as="sourcePoint"/><mxPoint x="480.0" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="302" as="sourcePoint"/><mxPoint x="480.0" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e5" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="412" as="sourcePoint"/><mxPoint x="480.0" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e6" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="510" as="sourcePoint"/><mxPoint x="480.0" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e7" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.0" y="620" as="sourcePoint"/><mxPoint x="480.0" y="648" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e8" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="590" as="sourcePoint"/><mxPoint x="350" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e9" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785.0" y="200" as="sourcePoint"/><mxPoint x="785.0" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e10" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785.0" y="320" as="sourcePoint"/><mxPoint x="785.0" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e11" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785.0" y="460" as="sourcePoint"/><mxPoint x="785.0" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e12" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="687" as="sourcePoint"/><mxPoint x="785.0" y="590" as="targetPoint"/><Array as="points"><mxPoint x="785.0" y="687"/></Array></mxGeometry></mxCell><mxCell id="e13" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="141" as="sourcePoint"/><mxPoint x="655" y="141" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e14" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090.0" y="200" as="sourcePoint"/><mxPoint x="1090.0" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e15" value="" style="rounded=1;html=1;strokeColor=#4a4760;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="915" y="520" as="sourcePoint"/><mxPoint x="960" y="150" as="targetPoint"/><Array as="points"><mxPoint x="938" y="520"/><mxPoint x="938" y="150"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="rounded=1;html=1;strokeColor=#8a5cc2;strokeWidth=1.4;fontSize=11;fontColor=#4a4760;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1090.0" y="590" as="sourcePoint"/><mxPoint x="480.0" y="726" as="targetPoint"/><Array as="points"><mxPoint x="1090.0" y="800"/><mxPoint x="480.0" y="800"/></Array></mxGeometry></mxCell><mxCell id="t0" value="Part B tracking framework: Capture → Compute → Act → Learn" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#3b3560;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="706" height="28" as="geometry"/></mxCell><mxCell id="t1" value="read" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#3b3560;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="317" y="570" width="36" height="19" as="geometry"/></mxCell><mxCell id="t2" value="scores" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#3b3560;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="690" y="667" width="50" height="19" as="geometry"/></mxCell><mxCell id="t3" value="per answer" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#3b3560;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="602" y="121" width="76" height="19" as="geometry"/></mxCell><mxCell id="t4" value="flagged" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#3b3560;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="919" y="499" width="56" height="19" as="geometry"/></mxCell><mxCell id="t5" value="better weights and questions go back in" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#3b3560;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="656" y="780" width="267" height="19" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>